PORT=3000
NODE_ENV=development

# Supabase Credentials (from your Supabase project dashboard -> Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed Frontend Origins (comma separated or * for dev)
FRONTEND_URL=*

# JWT Secret fallback for local verification
JWT_SECRET=trackflow-production-jwt-secret-key-32chars-min!
